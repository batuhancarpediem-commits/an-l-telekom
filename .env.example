# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env dosyası ASLA GitHub'a yüklenmez (.gitignore'da).

# Ses sağlayıcısını zorlamak isterseniz (boş bırakırsanız config.json'daki "auto" çalışır):
# TTS_PROVIDER=elevenlabs

# ElevenLabs (en doğal ses). Voice ID'yi ElevenLabs Voice Library'den Türkçe konuşan bir kadın sesi seçerek alın.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Cloud Text-to-Speech (REST API anahtarı)
GOOGLE_TTS_API_KEY=
